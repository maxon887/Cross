<Shader>
	<Vertex filename="Engine/Shaders/Sources/MultiLight.vert"/>
	<Fragment filename="Engine/Shaders/Sources/MultiLight.frag"/>
	<Uniforms>
		<Uniform name="Transparency" glName="uTransparency" type="Float"/>
		<Uniform name="Diffuse Color" glName="uDiffuseColor" type="Color"/>
		<Uniform name="Specular" glName="uSpecular" type="Float" value="2.0"/>
		<Uniform name="Shininess" glName="uShininess" type="Float" value="64.0"/>
	</Uniforms>
</Shader>